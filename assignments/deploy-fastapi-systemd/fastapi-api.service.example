[Unit]
Description=FastAPI Assignment Service
After=network.target

[Service]
User=vscode
Group=vscode
WorkingDirectory=/workspaces/skills-customize-your-github-copilot-experience/assignments/deploy-fastapi-systemd
Environment=APP_ENV=production
ExecStart=/usr/bin/env uvicorn starter-code:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
